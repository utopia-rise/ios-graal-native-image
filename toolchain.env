JDK_VERSION=25
# Must match the labs-openjdk submodule (JDK 25.0.2). JDK 25.0.3 replaced
# java.io.Console.istty with ttyStatus, so a newer GraalVM builds images that
# reference a JNI native these static libraries do not provide.
GRAALVM_VERSION=25.0.2
JVMCI_VERSION=jvmci-25.0-ios
IOS_MIN_VERSION=14.0
DEFAULT_RELEASE_VERSION=jdk25
